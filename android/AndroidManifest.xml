<?xml version="1.0" encoding="utf-8"?>
<!-- The game as an Android application: psvrecore's launcher (straight on to the game when its files are there;
     otherwise a menu, which imports them with the system's folder picker) and activity (SDL's, running
     libmain.so). Packaged by scripts/android_apk.py. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.adamfull.p4dancingallnight"
    android:installLocation="auto">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Persona 4: Dancing All Night"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="false"
        android:appCategory="game"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name="io.github.adamfull.psvrecore.LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- (the files without which the launcher shows its menu instead of starting the game: the base game's
                 data and the update 01.01, the version the code was generated from; the add-on content is optional) -->
            <meta-data
                android:name="psvrecore.required"
                android:value="app/PCSB00867/eboot.bin;app/PCSB00867/data/data.cpk;app/PCSB00867/data/vita.cpk;patch/PCSB00867/eboot.bin;patch/PCSB00867/data/patch.cpk;patch/PCSB00867/sce_module/libc.suprx;patch/PCSB00867/sce_module/libfios2.suprx" />
        </activity>
        <activity
            android:name="io.github.adamfull.psvrecore.PsvrecoreActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|fontScale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <!-- (the settings: from the launcher, or over the game) -->
        <activity
            android:name="io.github.adamfull.psvrecore.SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
